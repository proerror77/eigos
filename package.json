{
  "name": "eigos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared authenticated task gateway for MCP and A2A agents",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "example": "node --env-file=.env --import tsx examples/round-trip.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
