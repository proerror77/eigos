{
  "name": "eigos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared authenticated task gateway for MCP and A2A agents",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "setup:auth0": "node scripts/setup-auth0.mjs",
    "verify:member-agent": "node --env-file=data/auth0-live/agent.env --import tsx examples/member-oauth-agent.ts",
    "verify:agent-onboarding": "node --env-file=data/agent-onboarding-live/connector.env --import tsx examples/agent-onboarding-live.ts",
    "verify:shopify-readonly": "node --import tsx examples/verify-shopify-readonly.ts",
    "members": "node --env-file-if-exists=.env scripts/members.mjs",
    "dev": "node --env-file=.env scripts/run-local.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/run-local.mjs --built",
    "example": "node --env-file=.env --import tsx examples/round-trip.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "node --test dist/tests/e2e/*.test.js",
    "dev:gateway": "node --env-file=.env --import tsx apps/gateway/main.ts",
    "dev:worker": "node --env-file=.env --import tsx apps/worker/main.ts",
    "start:gateway": "node --env-file-if-exists=.env dist/apps/gateway/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/main.js",
    "setup:pa": "node scripts/setup-pa.mjs",
    "source:personal": "node --env-file-if-exists=.env scripts/personal-source.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
