{
  "name": "eigos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL Ontology runtime for agent queries, functions and actions",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:changed": "node scripts/test.mjs",
    "test:e2e:run": "node scripts/test.mjs --e2e",
    "test:e2e:changed": "node scripts/test.mjs --e2e",
    "ontology:check": "node --import tsx scripts/ontology.ts check",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts initialize",
    "ontology:publish": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts publish",
    "dev:gateway": "node --env-file-if-exists=.env --import tsx apps/gateway/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "start:gateway": "node --env-file-if-exists=.env dist/apps/gateway/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/main.js",
    "db:upgrade": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts upgrade",
    "ontology:prepare": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts prepare",
    "ontology:activate": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts activate",
    "access:grant-member": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts grant-member",
    "access:configure": "node --env-file-if-exists=.env --import tsx scripts/ontology.ts permissions",
    "start:indexer": "node --env-file-if-exists=.env dist/apps/indexer/main.js",
    "dev:indexer": "node --env-file-if-exists=.env --import tsx apps/indexer/main.ts",
    "embeddings:warm": "node --env-file-if-exists=.env --import tsx scripts/warm-embeddings.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
