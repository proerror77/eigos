      "id": "SearchRollingGoAirports",
      "description": "Read-only domestic RollingGo airport code lookup.",
      "resultType": "RollingGoFlightObservation",
      "mcp": {
        "server": "rollinggo-flight",
        "tool": "searchAirports",
        "arguments": {
          "keyword": {
            "from": "scope",
            "path": [
              "keyword"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": [],
        "encoding": "json"
      }
    },
