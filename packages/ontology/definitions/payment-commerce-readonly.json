{
  "format": "eigos.ontology.mcp-reads.v1",
  "id": "payment-commerce.readonly",
  "version": "1",
  "completion": {
    "evaluate": "paymentCommerceReadStatus"
  },
  "actions": [
    {
      "id": "QueryAlipayTrade",
      "description": "Query an existing merchant trade using the official Alipay MCP. Read only; does not create, pay, refund or close an order.",
      "resultType": "PaymentCommerceReadObservation",
      "mcp": {
        "server": "alipay",
        "tool": "query-alipay-payment",
        "encoding": "json",
        "arguments": {
          "outTradeNo": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "outTradeNo"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": []
      }
    },
    {
      "id": "QueryWechatPayTrade",
      "description": "Read an existing ordinary merchant order through the EIGOS APIv3 adapter with request signing and response verification. This is not the AI card or SkillPay purchasing flow.",
      "resultType": "PaymentCommerceReadObservation",
      "mcp": {
        "server": "wechatpay",
        "tool": "query-wechatpay-order",
        "encoding": "json",
        "arguments": {
          "outTradeNo": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "outTradeNo"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": []
      }
    },
    {
      "id": "QueryUnionPayTrade",
      "description": "Query one original UnionPay trade through its MCP. Preserve order ID and original transaction time. Never create a contract, send SMS, pay or refund.",
      "resultType": "PaymentCommerceReadObservation",
      "mcp": {
        "server": "unionpay",
        "tool": "query-unionpay-payment",
        "encoding": "json",
        "arguments": {
          "orderId": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "orderId"
            ]
          },
          "txnTime": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "txnTime"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": []
      }
    },
    {
      "id": "SearchTaobaoProducts",
      "description": "Search the authorized Taobao affiliate catalog through TOP. Prices are observations, not checkout totals or stock guarantees. No cart, order or payment.",
      "resultType": "PaymentCommerceReadObservation",
      "mcp": {
        "server": "taobao",
        "tool": "taobao.tbk.dg.material.optional",
        "encoding": "json",
        "arguments": {
          "q": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "query"
            ]
          },
          "page_no": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "page"
            ]
          },
          "page_size": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "limit"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": []
      }
    },
    {
      "id": "GetTaobaoProducts",
      "description": "Read up to 20 explicitly supplied Taobao item IDs through TOP. No order or payment; links and prices remain source data.",
      "resultType": "PaymentCommerceReadObservation",
      "mcp": {
        "server": "taobao",
        "tool": "taobao.tbk.item.info.get",
        "encoding": "json",
        "arguments": {
          "num_iids": {
            "from": "scope",
            "path": [
              "input",
              "parameters",
              "itemIds"
            ]
          }
        },
        "requires": [],
        "inputMatchesScope": []
      }
    }
  ]
}
