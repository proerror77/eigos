          },
          "links": {
            "origin": "origin",
            "destination": "destination"
          },
          "actions": {
            "requestEstimate": {
              "action": "RequestRideEstimate",
              "parameters": {
                "requestId": "requestId",
                "route": "route",
                "requestedAt": "requestedAt"
              }
            }
          }
        }
      }
    },
    {
      "apiName": "RideRequest",
      "displayName": "RideRequest",
