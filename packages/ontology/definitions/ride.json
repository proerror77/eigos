{
  "id": "Eigos",
  "version": "1",
  "objectTypes": [
    {
      "apiName": "Place",
      "displayName": "Place",
      "description": "A source-identified physical place",
      "primaryKey": "id",
      "titleProperty": "name",
      "properties": {
        "id": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable object identity",
          "required": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display name",
          "required": true
        },
        "city": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Provider city",
          "required": true
        },
        "address": {
          "schema": {
            "type": "string"
          },
          "description": "Full source address",
          "required": true
        },
        "coordinates": {
          "schema": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lng"
            ],
            "additionalProperties": false
          },
          "description": "Provider coordinates",
          "required": true
        },
        "coordinateSystem": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Source coordinate reference system",
          "required": true
        },
        "sourceBinding": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Provider account binding",
          "required": true
        },
        "observedAt": {
          "schema": {
            "type": "string",
            "format": "date-time"
          },
          "description": "Time of source observation",
          "required": true
        }
      },
      "interfaces": {
        "Location": {
          "properties": {
            "name": "name",
            "city": "city",
            "address": "address",
            "coordinates": "coordinates",
            "coordinateSystem": "coordinateSystem"
          },
          "links": {},
          "actions": {}
        }
      }
    },
    {
      "apiName": "Route",
      "displayName": "Route",
      "description": "A directed route between two selected places",
      "primaryKey": "id",
      "titleProperty": "name",
      "properties": {
        "id": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable object identity",
          "required": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display name",
          "required": true
        }
      },
      "interfaces": {
