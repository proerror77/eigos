          },
          "description": "Inquiry status",
          "required": true
        },
        "requestedAt": {
          "schema": {
            "type": "string",
            "format": "date-time"
          },
          "description": "Request time",
          "required": true
        }
      },
      "interfaces": {}
    },
    {
      "apiName": "RideEstimate",
      "displayName": "RideEstimate",
      "description": "One provider estimate for a route and vehicle category",
      "primaryKey": "id",
      "titleProperty": "name",
      "properties": {
        "id": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable object identity",
          "required": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display name",
          "required": true
        },
        "estimatedAmount": {
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Exact displayed estimate in CNY major units, otherwise null",
          "required": true
        },
        "currency": {
          "schema": {
            "const": "CNY",
            "type": "string"
          },
          "description": "Estimate currency",
          "required": true
        },
        "priceText": {
          "schema": {
            "type": "string"
          },
          "description": "Original source price",
          "required": true
        },
        "expiresAt": {
          "schema": {
            "type": "string",
            "format": "date-time"
          },
          "description": "Refresh deadline",
          "required": true
        },
        "observedAt": {
          "schema": {
            "type": "string",
            "format": "date-time"
          },
          "description": "Provider read time",
          "required": true
        },
        "productCategory": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Source vehicle category",
          "required": true
        },
        "feesComplete": {
          "schema": {
            "type": "string",
            "const": "unknown"
          },
          "description": "Provider did not verify full fees",
          "required": true
        }
      },
      "interfaces": {
        "PriceEstimate": {
          "properties": {
            "amount": "estimatedAmount",
            "currency": "currency",
            "priceText": "priceText",
            "expiresAt": "expiresAt",
            "name": "name"
          },
          "links": {
            "request": "request",
            "source": "source"
          },
          "actions": {}
        }
      }
    },
    {
      "apiName": "SourceReceipt",
      "displayName": "SourceReceipt",
      "description": "One provider read and its provenance",
      "primaryKey": "id",
      "titleProperty": "name",
      "properties": {
        "id": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable object identity",
          "required": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display name",
          "required": true
        },
        "bindingId": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exact source account",
          "required": true
        },
        "tool": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Provider read operation",
          "required": true
        },
        "observedAt": {
          "schema": {
            "type": "string",
            "format": "date-time"
          },
          "description": "Provider response time",
          "required": true
        },
        "evidence": {
          "schema": {
            "type": "string",
            "enum": [
              "live_readonly",
              "provider_mock",
              "fixture"
            ]
          },
          "description": "Origin of the observation",
          "required": true
        },
        "contentDigest": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Digest of validated source content",
          "required": true
        }
      },
      "interfaces": {}
    }
  ],
