  "functionTypes": [
    {
      "apiName": "searchPlaces",
      "description": "Search the provider for the given name and city",
      "parameters": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "city",
          "keywords"
        ],
        "additionalProperties": false
      },
      "returns": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "places"
                  },
                  "places": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "address": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "addressAll": {
                          "type": "string",
                          "maxLength": 1500
                        },
                        "city": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "lng": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "coordinateSystem": {
                          "type": "string",
                          "const": "provider_unspecified"
                        },
                        "identityKind": {
                          "type": "string",
                          "const": "local_snapshot_digest"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "address",
                        "addressAll",
                        "city",
                        "lng",
                        "lat",
                        "coordinateSystem",
                        "identityKind"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "kind",
                  "places"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "estimate"
                  },
                  "items": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "productCategory": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "priceText": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "priceKind": {
                          "type": "string",
                          "const": "estimate"
                        },
                        "estimatedMoney": {
                          "type": "object",
                          "properties": {
                            "minor": {
                              "type": "string",
                              "pattern": "^(0|[1-9]\\d{0,17})$"
                            },
                            "currency": {
                              "type": "string",
                              "const": "CNY"
                            }
                          },
                          "required": [
                            "minor",
                            "currency"
                          ],
                          "additionalProperties": false
                        },
                        "feesComplete": {
                          "type": "string",
                          "const": "unknown"
                        }
                      },
                      "required": [
                        "productName",
                        "productCategory",
                        "priceText",
                        "priceKind",
                        "feesComplete"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "kind",
                  "items"
                ],
                "additionalProperties": false
              }
            ]
          },
          "receipt": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "bindingId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              "environment": {
                "type": "string",
                "enum": [
                  "production",
                  "mock"
                ]
              },
              "endpoint": {
                "type": "string",
                "enum": [
                  "https://mcp.didichuxing.com/mcp-servers",
                  "https://mcp.didichuxing.com/mcp-servers-sandbox"
                ]
              },
              "tool": {
                "type": "string",
                "enum": [
                  "maps_textsearch",
                  "taxi_estimate"
                ]
              },
              "inputDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "resultDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "responseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "toolSchemaDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "startedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "receivedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "id",
              "bindingId",
              "environment",
              "endpoint",
              "tool",
              "inputDigest",
              "resultDigest",
              "responseSha256",
              "toolSchemaDigest",
              "startedAt",
              "receivedAt"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "string",
            "enum": [
              "live_readonly",
              "provider_mock",
              "fixture"
            ]
          }
        },
        "required": [
          "data",
          "receipt",
          "evidence"
        ],
        "additionalProperties": false
      },
      "source": "Didi"
    },
