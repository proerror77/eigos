        "id": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable object identity",
          "required": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display name",
          "required": true
        },
        "status": {
          "schema": {
            "type": "string",
            "enum": [
              "requested",
              "quoted"
