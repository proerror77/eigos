DATABASE_URL=postgres://eigos:replace-me@127.0.0.1:5432/eigos
EIGOS_PG_SCHEMA=eigos
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
EIGOS_AUTH_MODE=development
EIGOS_DEV_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Production uses EIGOS_AUTH_MODE=jwt and the existing identity provider.
# OAUTH_ISSUER=https://issuer.example/
# OAUTH_AUDIENCE=https://eigos.example/
# OAUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# OAUTH_TENANT_CLAIM=https://eigos.example/claims/tenant_id
# EIGOS_SOURCE_COMMIT=<deployed-commit-sha>
# EIGOS_DIDI_CONNECTION_FILE=/absolute/private/didi-connection.json
# EIGOS_SERVICE_CONNECTION_FILE=/absolute/private/service-connections.json

# Worker model runtime (installed separately; renew credentials through the existing login).
# EIGOS_HARNESS_BIN=/absolute/harness-runtime/node_modules/.bin/dsh
# EIGOS_HARNESS_CREDENTIAL_FILE=/absolute/private/model-access.json
EIGOS_HARNESS_MODEL=gpt-6.1-sol
EIGOS_HARNESS_REASONING_EFFORT=low
