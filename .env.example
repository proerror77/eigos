DATABASE_URL=postgres://eigos:replace-me@127.0.0.1:5432/eigos
EIGOS_PG_SCHEMA=eigos
# Enable after a database administrator installs owner isolation and verifies the runtime roles.
# EIGOS_ENFORCE_OWNER_RLS=true
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
EIGOS_AUTH_MODE=development
EIGOS_DEV_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Production uses EIGOS_AUTH_MODE=jwt and the existing identity provider.
# OAUTH_ISSUER=https://issuer.example/
# OAUTH_AUDIENCE=https://eigos.example/
# OAUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# OAUTH_TENANT_CLAIM=https://eigos.example/claims/tenant_id
# EIGOS_SOURCE_COMMIT=<deployed-commit-sha>
# EIGOS_DIDI_CONNECTION_FILE=/absolute/private/didi-connection.json
# EIGOS_SERVICE_CONNECTION_FILE=/absolute/private/service-connections.json
# EIGOS_PAOTUI_CONNECTION_FILE=/absolute/private/paotui-connection.json
# EIGOS_WAIMAI_CONNECTION_FILE=/absolute/private/waimai-connection.json
# EIGOS_AMAP_CONNECTION_FILE=/absolute/private/amap-connection.json
# EIGOS_XIAOHONGSHU_CONNECTION_FILE=/absolute/private/xiaohongshu-search.json
# EIGOS_DIANPING_CONNECTION_FILE=/absolute/private/dianping-poi.json
# EIGOS_JOURNEY_CALENDAR_CONNECTION_FILE=/absolute/private/google-calendar-readonly-connection.json
# EIGOS_TRAVEL_PA_CONNECTION_FILE=/absolute/private/travel-pa-connection.json
# EIGOS_VARIFLIGHT_CONNECTION_FILE=/absolute/private/variflight-connection.json
# EIGOS_FR24_CONNECTION_FILE=/absolute/private/fr24-connection.json
# EIGOS_FR24_MCP_ENTRYPOINT=/absolute/runtime/node_modules/@flightradar24/fr24api-mcp/build/index.js
# EIGOS_STRIPE_SANDBOX_CONNECTION_FILE=/absolute/private/stripe-sandbox-connection.json

# Worker model runtime (installed separately; renew credentials through the existing login).
# EIGOS_HARNESS_BIN=/absolute/harness-runtime/node_modules/.bin/dsh
# EIGOS_HARNESS_CREDENTIAL_FILE=/absolute/private/model-access.json
EIGOS_HARNESS_MODEL=gpt-6.1-sol
EIGOS_HARNESS_REASONING_EFFORT=low

# Optional shared cache for the pinned local embedding model; warm it before first use.
# EIGOS_EMBEDDING_CACHE=/absolute/eigos-cache/embeddings
