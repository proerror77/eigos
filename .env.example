DATABASE_URL=postgres://eigos:replace-me@127.0.0.1:5432/eigos
EIGOS_PG_SCHEMA=eigos
# Owner isolation. A database administrator runs `npm run db:enable-owner-isolation` and verifies the runtime roles
# first. Set it on the Gateway, Worker and Indexer. It is mandatory with the account portal below unless
# EIGOS_SIGNUP=closed, and the Gateway refuses to start without it. Optional for other deployments.
# EIGOS_ENFORCE_OWNER_RLS=true
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
EIGOS_AUTH_MODE=development
EIGOS_DEV_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Production uses EIGOS_AUTH_MODE=jwt and the existing identity provider.
# OAUTH_ISSUER=https://issuer.example/
# OAUTH_AUDIENCE=https://eigos.example/
# OAUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# Must equal the TENANT_CLAIM secret of the Auth0 Post-Login Action.
# OAUTH_TENANT_CLAIM=https://eigos.example/claims/tenant_id
# Account portal, self sign-up and Grok MCP (docs/guides/accounts.md). Configure the four OAUTH_* client variables,
# both secrets and, unless EIGOS_SIGNUP=closed, EIGOS_ENFORCE_OWNER_RLS=true together on the Gateway.
# With a partial set the Gateway refuses to start.
# OAUTH_MEMBER_CLIENT_ID=<Auth0 confidential web client>
# OAUTH_MEMBER_CLIENT_SECRET=<portal-only secret>
# OAUTH_MEMBER_MCP_CLIENT_ID=<Auth0 public Grok client>
# OAUTH_EXISTING_CLIENT_IDS=<comma-separated existing OAuth clients>
# Who may open an account: open (the default), invite or closed. Set invite before upgrading an invite-only
# deployment, otherwise the new default opens sign-up to everyone.
# EIGOS_SIGNUP=open
# At least 32 characters each and different from each other, for example `openssl rand -hex 32`.
# EIGOS_PORTAL_SECRET=<random secret that seals the login cookies>
# EIGOS_ACCOUNT_LINK_SECRET=<random secret, equal to the LINK_SECRET secret of the Auth0 Action>
# Optional pair, both or neither. Lets the account page ask Auth0 to resend the verification email. The client needs
# update:users.
# OAUTH_MANAGEMENT_CLIENT_ID=<Auth0 machine-to-machine client with update:users>
# OAUTH_MANAGEMENT_CLIENT_SECRET=<its client secret>
# The tenant's default Auth0 domain as a bare lowercase hostname, with no scheme, port or path. The Management token request,
# its audience and the verification email job go to it; without it they go to OAUTH_ISSUER. Required when OAUTH_ISSUER is an
# Auth0 custom domain, because the Management API stays on the default domain. Ignored unless the pair above is set.
# OAUTH_MANAGEMENT_DOMAIN=dev-abc.us.auth0.com
# Only behind a trusted reverse proxy that overwrites X-Forwarded-For, X-Forwarded-Host and X-Forwarded-Proto. Accepts a hop
# count, a preset name such as loopback, or a comma-separated list of proxy addresses or CIDRs. Any other value, including
# true, false and yes, stops the Gateway at startup. Express also takes req.hostname and req.protocol from these headers,
# and the Gateway's Host check uses req.hostname.
# EIGOS_TRUST_PROXY=1

# OAUTH_WORKBENCH_CLIENT_ID=<native-client-id-with-device-code-grant>
# EIGOS_SOURCE_COMMIT=<deployed-commit-sha>
# EIGOS_DIDI_CONNECTION_FILE=/absolute/private/didi-connection.json
# EIGOS_SERVICE_CONNECTION_FILE=/absolute/private/service-connections.json
# EIGOS_PAOTUI_CONNECTION_FILE=/absolute/private/paotui-connection.json
# EIGOS_WAIMAI_CONNECTION_FILE=/absolute/private/waimai-connection.json
# EIGOS_AMAP_CONNECTION_FILE=/absolute/private/amap-connection.json
# EIGOS_XIAOHONGSHU_CONNECTION_FILE=/absolute/private/xiaohongshu-search.json
# EIGOS_DIANPING_CONNECTION_FILE=/absolute/private/dianping-poi.json
# EIGOS_DINING_WEB_CONNECTION_FILE=/absolute/private/dining-web.json
# EIGOS_DINING_MINIPROGRAM_CONNECTION_FILE=/absolute/private/dining-miniprogram.json
# EIGOS_JOURNEY_CALENDAR_CONNECTION_FILE=/absolute/private/google-calendar-readonly-connection.json
# EIGOS_TRAVEL_PA_CONNECTION_FILE=/absolute/private/travel-pa-connection.json
# EIGOS_VARIFLIGHT_CONNECTION_FILE=/absolute/private/variflight-connection.json
# EIGOS_FR24_CONNECTION_FILE=/absolute/private/fr24-connection.json
# EIGOS_FR24_MCP_ENTRYPOINT=/absolute/runtime/node_modules/@flightradar24/fr24api-mcp/build/index.js
# EIGOS_STRIPE_SANDBOX_CONNECTION_FILE=/absolute/private/stripe-sandbox-connection.json

# Worker model runtime (installed separately; renew credentials through the existing login).
# EIGOS_HARNESS_BIN=/absolute/harness-runtime/node_modules/.bin/dsh
# EIGOS_HARNESS_CREDENTIAL_FILE=/absolute/private/model-access.json
EIGOS_HARNESS_MODEL=gpt-6.1-sol
EIGOS_HARNESS_REASONING_EFFORT=low
# EIGOS_AGENT_SANDBOX_ENABLED=true  # Enable sandbox capabilities for loopback development only.

# Optional shared cache for the pinned local embedding model; warm it before first use.
# EIGOS_EMBEDDING_CACHE=/absolute/eigos-cache/embeddings
