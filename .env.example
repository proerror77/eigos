# Production/resource-server configuration. Copy to .env and supply your own provider.
# For local development, use npm run setup:dev instead.
EIGOS_AUTH_MODE=jwt
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://eigos.example
# Gateway and Worker must point to the SAME local persistent file. Use an absolute path for separate working directories.
DATABASE_PATH=./data/eigos.sqlite
OAUTH_ISSUER=https://identity.example
OAUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
OAUTH_AUDIENCE=https://eigos.example
# Default signed tenant claim is tenant_id; Auth0 uses an explicitly configured namespaced claim.
# OAUTH_TENANT_CLAIM=https://your-resource.example/claims/tenant_id
# Optional member portal: register PUBLIC_URL/members/callback at the same OIDC provider.
# OIDC_CLIENT_ID=your-registered-member-portal-client
# OIDC_CLIENT_SECRET=your-private-client-secret
# Optional Auth0 public Agent connector client; requires device/refresh grants and enrollment Action.
# OIDC_AGENT_CLIENT_ID=your-registered-agent-connector-client
# Portal ID tokens must contain the configured signed tenant claim, matching the Agent access token identity.
EIGOS_MEMBERSHIP_APPROVAL=self-service
# Admission alternatives: manual (administrator approval) or invite-only (owner-bound invitation).
# Gateway only; independent of the Worker task database. Default: DATABASE_PATH + .members
MEMBERSHIP_DATABASE_PATH=./data/members.sqlite
# Comma-separated exact origins; empty permits only PUBLIC_URL.
ALLOWED_ORIGINS=
# Set the same capability switch in Gateway and Worker. Only Worker runs Codex (requires codex login there).
EIGOS_EXECUTOR=disabled
EIGOS_CODEX_BIN=codex
EIGOS_EXECUTOR_TIMEOUT_MS=120000
# Optional metadata-only HTTP audit; no credentials or message bodies are logged.
# EIGOS_AUDIT_PATH=./data/http-audit.jsonl
# Optional personal Meituan Paotui read-only adapter; loopback development only.
# EIGOS_PAOTUI_SKILL_DIR=/absolute/path/to/meituan-paotui
# Ontology MCP writes metadata-only read receipts here; no addresses, phones or tokens.
# EIGOS_ONTOLOGY_AUDIT_PATH=/absolute/path/to/private/ontology-reads.jsonl
# Keep false until a separate live-order authorization and checkout validation.
EIGOS_PAOTUI_ORDERS_ENABLED=false

# Local synthetic CSV audit only. Never connects to Alipay or charges real money.
EIGOS_CSV_PILOT=false
# Optional dedicated input directory; local development identity only.
# EIGOS_CSV_INPUT_DIR=/absolute/path/to/dedicated-csv-inputs

# Ontology + LLM backend. Existing dedicated prototypes are not execution fallbacks in this mode.
EIGOS_COORDINATOR=disabled
EIGOS_LIFE_INTAKE=false

# Engineering E2E only: both request.executionEnvironment=sandbox and an exact permit are required.
# Only authenticated http loopback endpoints are accepted. No real merchant or money.
EIGOS_ACTION_SANDBOX=false
# Total automatic task wait limit (default 24 hours, maximum 7 days). Expiry preserves unknown spend and permits explicit original-operation queries.
# EIGOS_TASK_MAX_MS=86400000
# EIGOS_SANDBOX_PROVIDER_URL=http://127.0.0.1:PORT
# EIGOS_SANDBOX_TOKEN_FILE=/absolute/path/to/private-sandbox-token
