[Unit]
Description=EIGOS agentgateway ingress
After=network.target

[Service]
Type=exec
DynamicUser=yes
ExecStartPre=/opt/eigos-agentgateway/v1.7.0/agentgateway --validate-only -f /etc/eigos-agentgateway/config.yaml
ExecStart=/opt/eigos-agentgateway/v1.7.0/agentgateway -f /etc/eigos-agentgateway/config.yaml
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
